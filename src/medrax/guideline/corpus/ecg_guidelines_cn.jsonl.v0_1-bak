{"id": "af_anticoag_2023", "society": "CSC", "doc_title": "心房颤动诊断和治疗中国指南", "version": "2023", "effective_date": "2023", "status": "current", "topic": "atrial_fibrillation", "section": "抗凝治疗", "class": "I", "LOE": "A", "lang": "zh", "citation": "中华医学会心血管病学分会, 中国生物医学工程学会心律分会. 心房颤动诊断和治疗中国指南(2023)", "text": "非瓣膜性房颤患者应根据CHA₂DS₂-VASc评分启动抗凝治疗，评分≥2分（男性）或≥3分（女性）优先选择NOAC而非华法林。", "supersedes": ["af_anticoag_2018"], "superseded_by": [], "verified": false}
{"id": "af_anticoag_2018", "society": "CSC", "doc_title": "心房颤动：目前的认识和治疗的建议", "version": "2018", "effective_date": "2018", "status": "superseded", "topic": "atrial_fibrillation", "section": "抗凝治疗", "class": "I", "LOE": "A", "lang": "zh", "citation": "中华医学会心电生理和起搏分会, 中国医师协会心律学专业委员会. 心房颤动：目前的认识和治疗的建议(2018)", "text": "非瓣膜性房颤CHA₂DS₂-VASc评分≥2分（男性）或≥3分（女性）应启动口服抗凝，华法林或NOAC均可作为选择。", "supersedes": [], "superseded_by": ["af_anticoag_2023"], "verified": false}
{"id": "af_rate_2023", "society": "CSC", "doc_title": "心房颤动诊断和治疗中国指南", "version": "2023", "effective_date": "2023", "status": "current", "topic": "atrial_fibrillation", "section": "心室率控制", "class": "IIa", "LOE": "B", "lang": "zh", "citation": "中华医学会心血管病学分会, 中国生物医学工程学会心律分会. 心房颤动诊断和治疗中国指南(2023)", "text": "对于血流动力学稳定且无明显症状的房颤患者，可采用宽松心室率控制策略（静息心率<110次/分）。", "supersedes": ["af_rate_2018"], "superseded_by": [], "verified": false}
{"id": "af_rate_2018", "society": "CSC", "doc_title": "心房颤动：目前的认识和治疗的建议", "version": "2018", "effective_date": "2018", "status": "superseded", "topic": "atrial_fibrillation", "section": "心室率控制", "class": "IIa", "LOE": "B", "lang": "zh", "citation": "中华医学会心电生理和起搏分会, 中国医师协会心律学专业委员会. 心房颤动：目前的认识和治疗的建议(2018)", "text": "对心功能正常的房颤患者，宽松心室率控制（静息心率<110次/分）可作为初始策略。", "supersedes": [], "superseded_by": ["af_rate_2023"], "verified": false}
{"id": "af_ablation_2023", "society": "CSC", "doc_title": "心房颤动诊断和治疗中国指南", "version": "2023", "effective_date": "2023", "status": "current", "topic": "atrial_fibrillation", "section": "节律控制/导管消融", "class": "IIa", "LOE": "B", "lang": "zh", "citation": "中华医学会心血管病学分会, 中国生物医学工程学会心律分会. 心房颤动诊断和治疗中国指南(2023)", "text": "有症状的阵发性房颤患者若抗心律失常药物治疗无效，可行导管消融；亦可根据患者意愿作为节律控制的一线治疗。", "supersedes": [], "superseded_by": [], "verified": false}
{"id": "avb_high_pacing", "society": "CSC", "doc_title": "心动过缓和传导异常患者的评估与管理中国专家共识", "version": "2020", "effective_date": "2020", "status": "current", "topic": "bradycardia_conduction", "section": "起搏适应证", "class": "I", "LOE": "C", "lang": "zh", "citation": "中华医学会心电生理和起搏分会, 中国医师协会心律学专业委员会. 心动过缓和传导异常患者的评估与管理中国专家共识(2020)", "text": "症状性三度或高度房室传导阻滞患者，推荐植入永久性心脏起搏器以改善症状和预后。", "supersedes": [], "superseded_by": [], "verified": false}
{"id": "snd_pacing", "society": "CSC", "doc_title": "心动过缓和传导异常患者的评估与管理中国专家共识", "version": "2020", "effective_date": "2020", "status": "current", "topic": "bradycardia_conduction", "section": "起搏适应证", "class": "I", "LOE": "C", "lang": "zh", "citation": "中华医学会心电生理和起搏分会, 中国医师协会心律学专业委员会. 心动过缓和传导异常患者的评估与管理中国专家共识(2020)", "text": "症状性窦房结功能障碍（病态窦房结综合征），明确症状与心动过缓直接相关时，推荐植入永久起搏器。", "supersedes": [], "superseded_by": [], "verified": false}
{"id": "firstdeg_avb_no_pacing", "society": "CSC", "doc_title": "心动过缓和传导异常患者的评估与管理中国专家共识", "version": "2020", "effective_date": "2020", "status": "current", "topic": "bradycardia_conduction", "section": "起搏适应证", "class": "III", "LOE": "C", "lang": "zh", "citation": "中华医学会心电生理和起搏分会, 中国医师协会心律学专业委员会. 心动过缓和传导异常患者的评估与管理中国专家共识(2020)", "text": "无症状的一度房室传导阻滞，不推荐植入永久起搏器。", "supersedes": [], "superseded_by": [], "verified": false}
{"id": "longqt_acquired", "society": "CSC", "doc_title": "室性心律失常中国专家共识", "version": "2020", "effective_date": "2020", "status": "current", "topic": "qt_channelopathy", "section": "QT延长处理", "class": "I", "LOE": "C", "lang": "zh", "citation": "中华医学会心电生理和起搏分会, 中国医师协会心律学专业委员会. 室性心律失常中国专家共识(2020)", "text": "获得性QT间期延长的首要处理是停用所有可能导致QT延长的药物，并积极纠正低钾、低镁等电解质紊乱。", "supersedes": [], "superseded_by": [], "verified": false}
{"id": "longqt_congenital_bb", "society": "CSC", "doc_title": "室性心律失常中国专家共识", "version": "2020", "effective_date": "2020", "status": "current", "topic": "qt_channelopathy", "section": "长QT综合征治疗", "class": "I", "LOE": "B", "lang": "zh", "citation": "中华医学会心电生理和起搏分会, 中国医师协会心律学专业委员会. 室性心律失常中国专家共识(2020)", "text": "确诊先天性长QT综合征的患者，除非存在禁忌证，应优先选用β受体阻滞剂作为一线治疗以预防恶性心律失常。", "supersedes": [], "superseded_by": [], "verified": false}
{"id": "stemi_ppci_2019", "society": "CSC", "doc_title": "急性ST段抬高型心肌梗死诊断和治疗指南", "version": "2019", "effective_date": "2019", "status": "current", "topic": "ischemia_stemi", "section": "再灌注治疗", "class": "I", "LOE": "A", "lang": "zh", "citation": "中华医学会心血管病学分会, 中华心血管病杂志编辑委员会. 急性ST段抬高型心肌梗死诊断和治疗指南(2019)", "text": "发病12小时以内的STEMI患者，应立即行直接PCI开通梗死相关动脉，尽可能将门-球时间控制在90分钟内。", "supersedes": ["stemi_ppci_2015"], "superseded_by": [], "verified": false}
{"id": "stemi_ppci_2015", "society": "CSC", "doc_title": "急性ST段抬高型心肌梗死诊断和治疗指南", "version": "2015", "effective_date": "2015", "status": "superseded", "topic": "ischemia_stemi", "section": "再灌注治疗", "class": "I", "LOE": "A", "lang": "zh", "citation": "中华医学会心血管病学分会, 中华心血管病杂志编辑委员会. 急性ST段抬高型心肌梗死诊断和治疗指南(2015)", "text": "发病12小时内的STEMI患者应尽快行直接PCI，缩短总缺血时间。", "supersedes": [], "superseded_by": ["stemi_ppci_2019"], "verified": false}
{"id": "stemi_lysis", "society": "CSC", "doc_title": "急性ST段抬高型心肌梗死诊断和治疗指南", "version": "2019", "effective_date": "2019", "status": "current", "topic": "ischemia_stemi", "section": "再灌注治疗", "class": "I", "LOE": "A", "lang": "zh", "citation": "中华医学会心血管病学分会, 中华心血管病杂志编辑委员会. 急性ST段抬高型心肌梗死诊断和治疗指南(2019)", "text": "STEMI发病<12小时且首次医疗接触至导丝通过时间预计>120分钟，若无禁忌应行静脉溶栓治疗。", "supersedes": [], "superseded_by": [], "verified": false}
{"id": "svt_acute_vagal", "society": "CSC", "doc_title": "室上性心动过速相关共识/指南", "version": "2021", "effective_date": "2021", "status": "current", "topic": "svt", "section": "急性终止", "class": "I", "LOE": "B", "lang": "zh", "citation": "中华医学会心电生理和起搏分会, 中国医师协会心律学专业委员会. 室上性心动过速诊断及治疗中国专家共识(2021)", "text": "血流动力学稳定的规则窄QRS波室上性心动过速，应首先尝试迷走神经刺激，无效则静脉快速推注腺苷。", "supersedes": [], "superseded_by": [], "verified": false}
{"id": "svt_ablation", "society": "CSC", "doc_title": "室上性心动过速相关共识/指南", "version": "2021", "effective_date": "2021", "status": "current", "topic": "svt", "section": "导管消融", "class": "I", "LOE": "B", "lang": "zh", "citation": "中华医学会心电生理和起搏分会, 中国医师协会心律学专业委员会. 室上性心动过速诊断及治疗中国专家共识(2021)", "text": "反复发作的症状性室上性心动过速，推荐行导管消融根治治疗。", "supersedes": [], "superseded_by": [], "verified": false}
{"id": "hyperkalemia_ecg", "society": "CSC", "doc_title": "电解质紊乱心电图与处理相关共识", "version": "2020", "effective_date": "2020", "status": "current", "topic": "electrolyte", "section": "高钾血症", "class": "I", "LOE": "C", "lang": "zh", "citation": "中华医学会心血管病学分会, 相关专家组. 电解质紊乱心电图与临床处理专家共识(2020)", "text": "高钾血症出现心电图异常（T波高尖、QRS增宽等）时，应立即静脉注射钙剂以稳定心肌细胞膜电位，预防恶性心律失常。", "supersedes": [], "superseded_by": [], "verified": false}
{"id": "hypokalemia_ecg", "society": "CSC", "doc_title": "电解质紊乱心电图与处理相关共识", "version": "2020", "effective_date": "2020", "status": "current", "topic": "electrolyte", "section": "低钾血症", "class": "I", "LOE": "C", "lang": "zh", "citation": "中华医学会心血管病学分会, 相关专家组. 电解质紊乱心电图与临床处理专家共识(2020)", "text": "低钾血症出现U波等特征性心电图改变时，应及时静脉或口服补钾，同时针对病因治疗。", "supersedes": [], "superseded_by": [], "verified": false}
