{"id": "af_1", "society": "CSC", "doc_title": "心房颤动诊断和治疗中国指南", "version": "2023", "effective_date": "2023", "status": "current", "topic": "atrial_fibrillation", "section": "抗凝", "class": "I", "LOE": "A", "lang": "zh", "citation": "中华医学会心血管病学分会, 心房颤动诊断和治疗中国指南, 2023", "text": "对于合并ACS或接受PCI的房颤患者，推荐使用NOAC联合P2Y12抑制剂的双联抗栓方案，无需常规联用阿司匹林，并根据缺血及出血风险决定疗程。", "supersedes": ["af_2"], "superseded_by": [], "verified": false, "confidence": "high", "ai_check": "ok"}
{"id": "af_2", "society": "CSC", "doc_title": "心房颤动:目前的认识和治疗的建议", "version": "2018", "effective_date": "2018", "status": "superseded", "topic": "atrial_fibrillation", "section": "抗凝", "class": "IIa", "LOE": "C", "lang": "zh", "citation": "中华医学会心血管病学分会, 心房颤动:目前的认识和治疗的建议, 2018", "text": "对于房颤合并PCI的患者，可考虑三联抗栓治疗（口服抗凝药+阿司匹林+氯吡格雷）1~6个月，然后改为双联抗栓（口服抗凝药+氯吡格雷或阿司匹林）至12个月。", "supersedes": [], "superseded_by": ["af_1"], "verified": false, "confidence": "med", "ai_check": "ok"}
{"id": "af_3", "society": "CSC", "doc_title": "心房颤动诊断和治疗中国指南", "version": "2023", "effective_date": "2023", "status": "current", "topic": "atrial_fibrillation", "section": "心室率控制", "class": "IIa", "LOE": "B", "lang": "zh", "citation": "中华医学会心血管病学分会, 心房颤动诊断和治疗中国指南, 2023", "text": "地高辛仅推荐用于β受体阻滞剂或非二氢吡啶类钙拮抗剂控制心室率效果不佳或存在禁忌时的二线治疗。", "supersedes": ["af_4"], "superseded_by": [], "verified": false, "confidence": "high", "ai_check": "ok"}
{"id": "af_4", "society": "CSC", "doc_title": "心房颤动:目前的认识和治疗的建议", "version": "2018", "effective_date": "2018", "status": "superseded", "topic": "atrial_fibrillation", "section": "心室率控制", "class": "I", "LOE": "B", "lang": "zh", "citation": "中华医学会心血管病学分会, 心房颤动:目前的认识和治疗的建议, 2018", "text": "对于房颤合并心力衰竭的患者，推荐使用地高辛作为控制心室率的一线或重要选择。", "supersedes": [], "superseded_by": ["af_3"], "verified": false, "confidence": "med", "ai_check": "ok"}
{"id": "af_5", "society": "CSC", "doc_title": "心房颤动诊断和治疗中国指南", "version": "2023", "effective_date": "2023", "status": "current", "topic": "atrial_fibrillation", "section": "抗凝", "class": "I", "LOE": "A", "lang": "zh", "citation": "中华医学会心血管病学分会, 心房颤动诊断和治疗中国指南, 2023", "text": "建议使用CHA2DS2-VASc评分评估非瓣膜性房颤患者的卒中风险，评分≥2分（男性）或≥3分（女性）者应启动口服抗凝治疗。", "supersedes": [], "superseded_by": [], "verified": false, "confidence": "high", "ai_check": "ok"}
{"id": "af_6", "society": "CSC", "doc_title": "心房颤动诊断和治疗中国指南", "version": "2023", "effective_date": "2023", "status": "current", "topic": "atrial_fibrillation", "section": "抗凝", "class": "I", "LOE": "A", "lang": "zh", "citation": "中华医学会心血管病学分会, 心房颤动诊断和治疗中国指南, 2023", "text": "在适合使用非维生素K拮抗剂口服抗凝药（NOAC）的患者中，NOAC的获益‑风险优于华法林，推荐优先选择NOAC。", "supersedes": [], "superseded_by": [], "verified": false, "confidence": "high", "ai_check": "ok"}
{"id": "af_7", "society": "CSC", "doc_title": "心房颤动诊断和治疗中国指南", "version": "2023", "effective_date": "2023", "status": "current", "topic": "atrial_fibrillation", "section": "抗凝", "class": "I", "LOE": "B", "lang": "zh", "citation": "中华医学会心血管病学分会, 心房颤动诊断和治疗中国指南, 2023", "text": "高出血风险并非抗凝禁忌，在启动抗凝前应积极纠正可逆的出血危险因素，并定期重新评估出血与卒中风险。", "supersedes": [], "superseded_by": [], "verified": false, "confidence": "high", "ai_check": "ok"}
{"id": "af_8", "society": "CSC", "doc_title": "心房颤动诊断和治疗中国指南", "version": "2023", "effective_date": "2023", "status": "current", "topic": "atrial_fibrillation", "section": "抗凝", "class": "I", "LOE": "B", "lang": "zh", "citation": "中华医学会心血管病学分会, 心房颤动诊断和治疗中国指南, 2023", "text": "房颤或房扑持续≥48小时或时间不详者，在复律前应接受有效口服抗凝治疗至少3周，复律后继续抗凝4周；也可经食道超声心动图排除血栓后立即复律，并继以抗凝。", "supersedes": [], "superseded_by": [], "verified": false, "confidence": "high", "ai_check": "ok"}
{"id": "af_9", "society": "CSC", "doc_title": "心房颤动诊断和治疗中国指南", "version": "2023", "effective_date": "2023", "status": "current", "topic": "atrial_fibrillation", "section": "抗凝", "class": "IIa", "LOE": "B", "lang": "zh", "citation": "中华医学会心血管病学分会, 心房颤动诊断和治疗中国指南, 2023", "text": "房颤/房扑发作<48小时且卒中风险极低（CHA2DS2-VASc 0分男/1分女）的患者，无需经食道超声心动图检查即可直接复律。", "supersedes": [], "superseded_by": [], "verified": false, "confidence": "med", "ai_check": "ok"}
{"id": "af_10", "society": "CSC", "doc_title": "心房颤动诊断和治疗中国指南", "version": "2023", "effective_date": "2023", "status": "current", "topic": "atrial_fibrillation", "section": "心室率控制", "class": "I", "LOE": "B", "lang": "zh", "citation": "中华医学会心血管病学分会, 心房颤动诊断和治疗中国指南, 2023", "text": "对于稳定的房颤患者，推荐以宽松的心室率控制作为初始目标（静息心率<110次/分）；若症状仍持续，可进一步采取严格心室率控制。", "supersedes": [], "superseded_by": [], "verified": false, "confidence": "high", "ai_check": "ok"}
{"id": "af_11", "society": "CSC", "doc_title": "心房颤动诊断和治疗中国指南", "version": "2023", "effective_date": "2023", "status": "current", "topic": "atrial_fibrillation", "section": "节律控制与导管消融", "class": "I", "LOE": "A", "lang": "zh", "citation": "中华医学会心血管病学分会, 心房颤动诊断和治疗中国指南, 2023", "text": "对新诊断（<1年）的房颤且合并心血管危险因素的患者，推荐早期节律控制以改善心血管预后。", "supersedes": [], "superseded_by": [], "verified": false, "confidence": "high", "ai_check": "ok"}
{"id": "af_12", "society": "CSC", "doc_title": "心房颤动诊断和治疗中国指南", "version": "2023", "effective_date": "2023", "status": "current", "topic": "atrial_fibrillation", "section": "节律控制与导管消融", "class": "I", "LOE": "A", "lang": "zh", "citation": "中华医学会心血管病学分会, 心房颤动诊断和治疗中国指南, 2023", "text": "对于有症状的阵发性房颤患者，导管消融可作为节律控制的一线治疗选择。", "supersedes": [], "superseded_by": [], "verified": false, "confidence": "high", "ai_check": "ok"}
{"id": "af_13", "society": "CSC", "doc_title": "心房颤动诊断和治疗中国指南", "version": "2023", "effective_date": "2023", "status": "current", "topic": "atrial_fibrillation", "section": "节律控制与导管消融", "class": "I", "LOE": "B", "lang": "zh", "citation": "中华医学会心血管病学分会, 心房颤动诊断和治疗中国指南, 2023", "text": "对于合并射血分数降低的心力衰竭（HFrEF）的房颤患者，导管消融可改善生存率并降低心衰再住院风险。", "supersedes": [], "superseded_by": [], "verified": false, "confidence": "high", "ai_check": "conflict", "ai_note": "2023中国房颤指南对合并HFrEF的非心动过速性心肌病房颤患者导管消融推荐为IIa类B级，非I类；条目将推荐级别由IIa提升至I，与指南不符。"}
{"id": "af_14", "society": "CSC", "doc_title": "心房颤动诊断和治疗中国指南", "version": "2023", "effective_date": "2023", "status": "current", "topic": "atrial_fibrillation", "section": "电复律及复律前抗凝", "class": "I", "LOE": "C", "lang": "zh", "citation": "中华医学会心血管病学分会, 心房颤动诊断和治疗中国指南, 2023", "text": "对房颤或房扑导致血流动力学恶化或出现急性心力衰竭、心肌缺血等危急情况时，应紧急行同步直流电复律。", "supersedes": [], "superseded_by": [], "verified": false, "confidence": "high", "ai_check": "ok"}
{"id": "af_15", "society": "CSC", "doc_title": "心房颤动诊断和治疗中国指南", "version": "2023", "effective_date": "2023", "status": "current", "topic": "atrial_fibrillation", "section": "房扑", "class": "I", "LOE": "B", "lang": "zh", "citation": "中华医学会心血管病学分会, 心房颤动诊断和治疗中国指南, 2023", "text": "非瓣膜性房扑患者的卒中风险评估及抗凝策略应依照房颤的CHA2DS2-VASc评分体系，同等启动抗凝治疗。", "supersedes": [], "superseded_by": [], "verified": false, "confidence": "high", "ai_check": "ok"}
{"id": "af_16", "society": "CSC", "doc_title": "心房颤动诊断和治疗中国指南", "version": "2023", "effective_date": "2023", "status": "current", "topic": "atrial_fibrillation", "section": "房扑", "class": "I", "LOE": "A", "lang": "zh", "citation": "中华医学会心血管病学分会, 心房颤动诊断和治疗中国指南, 2023", "text": "对于症状性典型心房扑动，推荐导管消融三尖瓣峡部作为根治性一线治疗。", "supersedes": [], "superseded_by": [], "verified": false, "confidence": "high", "ai_check": "ok"}
{"id": "af_17", "society": "CSC", "doc_title": "心房颤动诊断和治疗中国指南", "version": "2023", "effective_date": "2023", "status": "current", "topic": "atrial_fibrillation", "section": "抗凝", "class": "I", "LOE": "B", "lang": "zh", "citation": "中华医学会心血管病学分会, 心房颤动诊断和治疗中国指南, 2023", "text": "服用达比加群发生严重出血时，推荐使用特异性逆转剂依达赛珠单抗拮抗；服用Xa因子抑制剂时，可考虑使用Andexanet alfa或凝血酶原复合物浓缩物。", "supersedes": [], "superseded_by": [], "verified": false, "confidence": "med", "ai_check": "conflict", "ai_note": "前半句达比加群出血使用依达赛珠单抗为I类推荐，后半句Xa因子抑制剂出血“可考虑”Andexanet alfa或PCC属于IIa/IIb类，将二者合并标为I类不恰当，与指南分级细节矛盾。"}
{"id": "brady_1", "society": "CSC", "doc_title": "心动过缓和传导异常患者的评估与管理中国专家共识(2020)", "version": "2020", "effective_date": "2020", "status": "current", "topic": "bradycardia_conduction", "section": "病态窦房结综合征起搏适应证", "class": "I", "LOE": "C", "lang": "zh", "citation": "中华医学会心电生理和起搏分会等. 心动过缓和传导异常患者的评估与管理中国专家共识. 2020", "text": "症状性心动过缓，且明确症状与窦房结功能障碍相关，是永久性心脏起搏的I类适应证。", "supersedes": [], "superseded_by": [], "verified": false, "confidence": "high", "ai_check": "ok"}
{"id": "brady_2", "society": "CSC", "doc_title": "心动过缓和传导异常患者的评估与管理中国专家共识(2020)", "version": "2020", "effective_date": "2020", "status": "current", "topic": "bradycardia_conduction", "section": "病态窦房结综合征起搏适应证", "class": "IIb", "LOE": "C", "lang": "zh", "citation": "中华医学会心电生理和起搏分会等. 心动过缓和传导异常患者的评估与管理中国专家共识. 2020", "text": "症状轻微，清醒状态下心率长期＜40次/分，或有窦房阻滞、窦性停搏的年轻患者，可考虑起搏。", "supersedes": [], "superseded_by": [], "verified": false, "confidence": "med", "ai_check": "ok"}
{"id": "brady_3", "society": "CSC", "doc_title": "心动过缓和传导异常患者的评估与管理中国专家共识(2020)", "version": "2020", "effective_date": "2020", "status": "current", "topic": "bradycardia_conduction", "section": "房室传导阻滞起搏适应证", "class": "I", "LOE": "C", "lang": "zh", "citation": "中华医学会心电生理和起搏分会等. 心动过缓和传导异常患者的评估与管理中国专家共识. 2020", "text": "三度或高度房室传导阻滞，无论有无症状，均应植入永久起搏器。", "supersedes": [], "superseded_by": [], "verified": false, "confidence": "high", "ai_check": "ok"}
{"id": "brady_4", "society": "CSC", "doc_title": "心动过缓和传导异常患者的评估与管理中国专家共识(2020)", "version": "2020", "effective_date": "2020", "status": "current", "topic": "bradycardia_conduction", "section": "房室传导阻滞起搏适应证", "class": "I", "LOE": "C", "lang": "zh", "citation": "中华医学会心电生理和起搏分会等. 心动过缓和传导异常患者的评估与管理中国专家共识. 2020", "text": "二度II型房室传导阻滞，无论有无症状，均推荐永久起搏。", "supersedes": [], "superseded_by": [], "verified": false, "confidence": "high", "ai_check": "ok"}
{"id": "brady_5", "society": "CSC", "doc_title": "心动过缓和传导异常患者的评估与管理中国专家共识(2020)", "version": "2020", "effective_date": "2020", "status": "current", "topic": "bradycardia_conduction", "section": "房室传导阻滞起搏适应证", "class": "IIa", "LOE": "C", "lang": "zh", "citation": "中华医学会心电生理和起搏分会等. 心动过缓和传导异常患者的评估与管理中国专家共识. 2020", "text": "症状性二度I型房室传导阻滞，电生理检查证实阻滞部位在希氏束内或以下水平，应考虑起搏。", "supersedes": [], "superseded_by": [], "verified": false, "confidence": "med", "ai_check": "ok"}
{"id": "brady_6", "society": "CSC", "doc_title": "心动过缓和传导异常患者的评估与管理中国专家共识(2020)", "version": "2020", "effective_date": "2020", "status": "current", "topic": "bradycardia_conduction", "section": "房室传导阻滞起搏适应证", "class": "III", "LOE": "C", "lang": "zh", "citation": "中华医学会心电生理和起搏分会等. 心动过缓和传导异常患者的评估与管理中国专家共识. 2020", "text": "无症状的二度I型房室传导阻滞，无论阻滞部位，不推荐起搏治疗。", "supersedes": [], "superseded_by": [], "verified": false, "confidence": "high", "ai_check": "ok"}
{"id": "brady_7", "society": "CSC", "doc_title": "心动过缓和传导异常患者的评估与管理中国专家共识(2020)", "version": "2020", "effective_date": "2020", "status": "current", "topic": "bradycardia_conduction", "section": "房室传导阻滞起搏适应证", "class": "IIb", "LOE": "C", "lang": "zh", "citation": "中华医学会心电生理和起搏分会等. 心动过缓和传导异常患者的评估与管理中国专家共识. 2020", "text": "一度房室传导阻滞（PR间期＞300ms）所致心房收缩与心室收缩失调，出现类似起搏器综合征症状或心衰，可尝试起搏。", "supersedes": [], "superseded_by": [], "verified": false, "confidence": "med", "ai_check": "ok"}
{"id": "brady_8", "society": "CSC", "doc_title": "心动过缓和传导异常患者的评估与管理中国专家共识(2020)", "version": "2020", "effective_date": "2020", "status": "current", "topic": "bradycardia_conduction", "section": "无症状一度房室传导阻滞", "class": "III", "LOE": "C", "lang": "zh", "citation": "中华医学会心电生理和起搏分会等. 心动过缓和传导异常患者的评估与管理中国专家共识. 2020", "text": "无症状的一度房室传导阻滞，无论PR间期多长，不应植入永久起搏器。", "supersedes": [], "superseded_by": [], "verified": false, "confidence": "high", "ai_check": "ok"}
{"id": "brady_9", "society": "CSC", "doc_title": "心动过缓和传导异常患者的评估与管理中国专家共识(2020)", "version": "2020", "effective_date": "2020", "status": "current", "topic": "bradycardia_conduction", "section": "束支/分支阻滞起搏适应证", "class": "IIb", "LOE": "C", "lang": "zh", "citation": "中华医学会心电生理和起搏分会等. 心动过缓和传导异常患者的评估与管理中国专家共识. 2020", "text": "不明原因晕厥合并束支阻滞，电生理检查HV间期≥70ms，可考虑起搏。", "supersedes": [], "superseded_by": [], "verified": false, "confidence": "med", "ai_check": "ok"}
{"id": "brady_10", "society": "CSC", "doc_title": "心动过缓和传导异常患者的评估与管理中国专家共识(2020)", "version": "2020", "effective_date": "2020", "status": "current", "topic": "bradycardia_conduction", "section": "双束支阻滞起搏适应证", "class": "I", "LOE": "C", "lang": "zh", "citation": "中华医学会心电生理和起搏分会等. 心动过缓和传导异常患者的评估与管理中国专家共识. 2020", "text": "双束支阻滞合并间歇性三度房室传导阻滞或二度II型房室传导阻滞，应植入永久起搏器。", "supersedes": [], "superseded_by": [], "verified": false, "confidence": "high", "ai_check": "ok"}
{"id": "brady_11", "society": "CSC", "doc_title": "心动过缓和传导异常患者的评估与管理中国专家共识(2020)", "version": "2020", "effective_date": "2020", "status": "current", "topic": "bradycardia_conduction", "section": "双束支阻滞起搏适应证", "class": "I", "LOE": "C", "lang": "zh", "citation": "中华医学会心电生理和起搏分会等. 心动过缓和传导异常患者的评估与管理中国专家共识. 2020", "text": "出现交替性束支阻滞，即使无症状，也应起搏。", "supersedes": [], "superseded_by": [], "verified": false, "confidence": "high", "ai_check": "ok"}
{"id": "brady_12", "society": "CSC", "doc_title": "心动过缓和传导异常患者的评估与管理中国专家共识(2020)", "version": "2020", "effective_date": "2020", "status": "current", "topic": "bradycardia_conduction", "section": "双束支阻滞起搏适应证", "class": "IIa", "LOE": "C", "lang": "zh", "citation": "中华医学会心电生理和起搏分会等. 心动过缓和传导异常患者的评估与管理中国专家共识. 2020", "text": "双束支阻滞合并不明原因晕厥，电生理检查HV间期≥100ms，应考虑起搏。", "supersedes": [], "superseded_by": [], "verified": false, "confidence": "med", "ai_check": "ok"}
{"id": "brady_13", "society": "CSC", "doc_title": "心动过缓和传导异常患者的评估与管理中国专家共识(2020)", "version": "2020", "effective_date": "2020", "status": "current", "topic": "bradycardia_conduction", "section": "CRT适应证", "class": "I", "LOE": "A", "lang": "zh", "citation": "中华医学会心电生理和起搏分会等. 心动过缓和传导异常患者的评估与管理中国专家共识. 2020", "text": "慢性心力衰竭合并左束支传导阻滞，窦性心律，QRS≥130ms，LVEF≤35%，应植入心脏再同步化治疗（CRT-P/CRT-D）。", "supersedes": [], "superseded_by": [], "verified": false, "confidence": "high", "ai_check": "ok"}
{"id": "brady_14", "society": "CSC", "doc_title": "心动过缓和传导异常患者的评估与管理中国专家共识(2020)", "version": "2020", "effective_date": "2020", "status": "current", "topic": "bradycardia_conduction", "section": "CRT适应证", "class": "IIa", "LOE": "B", "lang": "zh", "citation": "中华医学会心电生理和起搏分会等. 心动过缓和传导异常患者的评估与管理中国专家共识. 2020", "text": "高度房室传导阻滞需心室起搏，且LVEF≤35%的心衰患者，应考虑直接植入CRT而非右心室起搏。", "supersedes": [], "superseded_by": [], "verified": false, "confidence": "high", "ai_check": "ok"}
{"id": "brady_15", "society": "CSC", "doc_title": "植入性心脏起搏器治疗——目前认识和建议(2010)", "version": "2010", "effective_date": "2010", "status": "superseded", "topic": "bradycardia_conduction", "section": "双束支阻滞起搏适应证", "class": "IIb", "LOE": "C", "lang": "zh", "citation": "中华医学会心电生理和起搏分会. 植入性心脏起搏器治疗——目前认识和建议. 2010", "text": "双束支阻滞合并一度房室传导阻滞，即使无症状，也可考虑预防性起搏。", "supersedes": [], "superseded_by": ["brady_16"], "verified": false, "confidence": "low", "ai_check": "ok"}
{"id": "brady_16", "society": "CSC", "doc_title": "心动过缓和传导异常患者的评估与管理中国专家共识(2020)", "version": "2020", "effective_date": "2020", "status": "current", "topic": "bradycardia_conduction", "section": "双束支阻滞起搏适应证", "class": "III", "LOE": "C", "lang": "zh", "citation": "中华医学会心电生理和起搏分会等. 心动过缓和传导异常患者的评估与管理中国专家共识. 2020", "text": "无症状的双束支阻滞合并一度房室传导阻滞，不推荐预防性植入永久起搏器。", "supersedes": ["brady_15"], "superseded_by": [], "verified": false, "confidence": "low", "ai_check": "ok"}
{"id": "va_1", "society": "CSC", "doc_title": "室性心律失常中国专家共识", "version": "2020", "effective_date": "2020", "status": "current", "topic": "ventricular_arrhythmia", "section": "室性早搏导管消融", "class": "I", "LOE": "A", "lang": "zh", "citation": "中华医学会心电生理和起搏分会, 中国医师协会心律学专业委员会. 室性心律失常中国专家共识. 2020.", "text": "对于无结构性心脏病、症状显著且药物治疗无效或不愿长期服药的频发室性早搏患者，推荐导管消融作为一线治疗。", "supersedes": ["va_2"], "superseded_by": [], "verified": false, "confidence": "high", "ai_check": "conflict", "ai_note": "LOE错误。2020版共识对该推荐为Ⅰ类B级证据（无RCT支持A级），此处标为LOE A不符合指南原文。"}
{"id": "va_2", "society": "CSC", "doc_title": "室性心律失常中国专家共识", "version": "2016", "effective_date": "2016", "status": "superseded", "topic": "ventricular_arrhythmia", "section": "室性早搏导管消融", "class": "IIa", "LOE": "B", "lang": "zh", "citation": "中华医学会心电生理和起搏分会, 中国医师协会心律学专业委员会. 室性心律失常中国专家共识. 2016.", "text": "对无结构性心脏病、症状明显、药物治疗效果欠佳的频发室性早搏，可考虑导管消融。", "supersedes": [], "superseded_by": ["va_1"], "verified": false, "confidence": "low", "ai_check": "ok"}
{"id": "va_3", "society": "CSC", "doc_title": "室性心律失常中国专家共识", "version": "2020", "effective_date": "2020", "status": "current", "topic": "ventricular_arrhythmia", "section": "室性早搏诱发心肌病", "class": "I", "LOE": "B", "lang": "zh", "citation": "中华医学会心电生理和起搏分会, 中国医师协会心律学专业委员会. 室性心律失常中国专家共识. 2020.", "text": "对于频发室性早搏（负荷常>15%）导致左心室扩大或左心室射血分数下降，且排除其他病因的患者，推荐导管消融以逆转心肌病变。", "supersedes": [], "superseded_by": [], "verified": false, "confidence": "med", "ai_check": "ok"}
{"id": "va_4", "society": "CSC", "doc_title": "室性心律失常中国专家共识", "version": "2020", "effective_date": "2020", "status": "current", "topic": "ventricular_arrhythmia", "section": "非持续性室速处理", "class": "IIa", "LOE": "B", "lang": "zh", "citation": "中华医学会心电生理和起搏分会, 中国医师协会心律学专业委员会. 室性心律失常中国专家共识. 2020.", "text": "合并结构性心脏病的非持续性室速患者，推荐进一步危险分层，包括无创心脏影像评估及必要时行心脏电生理检查，以指导治疗。", "supersedes": [], "superseded_by": [], "verified": false, "confidence": "high", "ai_check": "ok"}
{"id": "va_5", "society": "CSC", "doc_title": "室性心律失常中国专家共识", "version": "2020", "effective_date": "2020", "status": "current", "topic": "ventricular_arrhythmia", "section": "持续性单形性室速急性处理", "class": "I", "LOE": "C", "lang": "zh", "citation": "中华医学会心电生理和起搏分会, 中国医师协会心律学专业委员会. 室性心律失常中国专家共识. 2020.", "text": "对于血流动力学不稳定的持续性单形性室速，应立即行同步直流电复律。", "supersedes": [], "superseded_by": [], "verified": false, "confidence": "high", "ai_check": "ok"}
{"id": "va_6", "society": "CSC", "doc_title": "室性心律失常中国专家共识", "version": "2020", "effective_date": "2020", "status": "current", "topic": "ventricular_arrhythmia", "section": "持续性单形性室速急性处理", "class": "IIa", "LOE": "A", "lang": "zh", "citation": "中华医学会心电生理和起搏分会, 中国医师协会心律学专业委员会. 室性心律失常中国专家共识. 2020.", "text": "血流动力学稳定的持续性单形性室速，可首选静脉胺碘酮或利多卡因行药物复律，无效时行同步电复律。", "supersedes": [], "superseded_by": [], "verified": false, "confidence": "high", "ai_check": "conflict", "ai_note": "利多卡因在2020版共识中为Ⅱb类B级，非首选；整体推荐不能笼统为Ⅱa类A级，且无A级证据。推荐类别和证据级别均与共识不符。"}
{"id": "va_7", "society": "CSC", "doc_title": "室性心律失常中国专家共识", "version": "2020", "effective_date": "2020", "status": "current", "topic": "ventricular_arrhythmia", "section": "多形性室速/室颤急性处理", "class": "I", "LOE": "A", "lang": "zh", "citation": "中华医学会心电生理和起搏分会, 中国医师协会心律学专业委员会. 室性心律失常中国专家共识. 2020.", "text": "持续性多形性室速或心室颤动，应立即予非同步双相波高能量电除颤。", "supersedes": [], "superseded_by": [], "verified": false, "confidence": "high", "ai_check": "ok"}
{"id": "va_8", "society": "CSC", "doc_title": "室性心律失常中国专家共识", "version": "2020", "effective_date": "2020", "status": "current", "topic": "ventricular_arrhythmia", "section": "ICD二级预防", "class": "I", "LOE": "A", "lang": "zh", "citation": "中华医学会心电生理和起搏分会, 中国医师协会心律学专业委员会. 室性心律失常中国专家共识. 2020.", "text": "因室速/室颤导致心脏骤停幸存，或血流动力学不稳定性室速，排除完全可逆原因后，推荐植入埋藏式心脏复律除颤器（ICD）行二级预防。", "supersedes": [], "superseded_by": [], "verified": false, "confidence": "high", "ai_check": "ok"}
{"id": "va_9", "society": "CSC", "doc_title": "室性心律失常中国专家共识", "version": "2020", "effective_date": "2020", "status": "current", "topic": "ventricular_arrhythmia", "section": "ICD一级预防（缺血性心肌病）", "class": "I", "LOE": "A", "lang": "zh", "citation": "中华医学会心电生理和起搏分会, 中国医师协会心律学专业委员会. 室性心律失常中国专家共识. 2020.", "text": "心肌梗死后至少40天、血运重建至少90天，经优化药物治疗后左心室射血分数（LVEF）仍≤35%，心功能Ⅱ或Ⅲ级，预期生存超过1年的患者，推荐植入ICD行一级预防。", "supersedes": [], "superseded_by": [], "verified": false, "confidence": "high", "ai_check": "ok"}
{"id": "va_10", "society": "CSC", "doc_title": "室性心律失常中国专家共识", "version": "2020", "effective_date": "2020", "status": "current", "topic": "ventricular_arrhythmia", "section": "ICD一级预防（非缺血性心肌病）", "class": "I", "LOE": "A", "lang": "zh", "citation": "中华医学会心电生理和起搏分会, 中国医师协会心律学专业委员会. 室性心律失常中国专家共识. 2020.", "text": "非缺血性心肌病，经优化药物治疗后LVEF≤35%，心功能Ⅱ或Ⅲ级，预期生存超过1年的患者，推荐植入ICD行一级预防。", "supersedes": [], "superseded_by": [], "verified": false, "confidence": "high", "ai_check": "ok"}
{"id": "va_11", "society": "CSC", "doc_title": "室性心律失常中国专家共识", "version": "2020", "effective_date": "2020", "status": "current", "topic": "ventricular_arrhythmia", "section": "电风暴处理", "class": "IIa", "LOE": "B", "lang": "zh", "citation": "中华医学会心电生理和起搏分会, 中国医师协会心律学专业委员会. 室性心律失常中国专家共识. 2020.", "text": "电风暴急性期，应联合静脉β受体阻滞剂与胺碘酮，给予适度镇静，若药物难以控制可早期考虑导管消融或机械循环支持。", "supersedes": [], "superseded_by": [], "verified": false, "confidence": "med", "ai_check": "ok"}
{"id": "va_12", "society": "CSC", "doc_title": "室性心律失常中国专家共识", "version": "2020", "effective_date": "2020", "status": "current", "topic": "ventricular_arrhythmia", "section": "特发性左室分支性室速导管消融", "class": "I", "LOE": "B", "lang": "zh", "citation": "中华医学会心电生理和起搏分会, 中国医师协会心律学专业委员会. 室性心律失常中国专家共识. 2020.", "text": "对症状明显、药物无效或不能耐受的维拉帕米敏感性左后分支性室速，推荐导管消融，成功率高且复发率低。", "supersedes": [], "superseded_by": [], "verified": false, "confidence": "high", "ai_check": "ok"}
{"id": "va_13", "society": "CSC", "doc_title": "室性心律失常中国专家共识", "version": "2020", "effective_date": "2020", "status": "current", "topic": "ventricular_arrhythmia", "section": "特发性流出道室速导管消融", "class": "I", "LOE": "B", "lang": "zh", "citation": "中华医学会心电生理和起搏分会, 中国医师协会心律学专业委员会. 室性心律失常中国专家共识. 2020.", "text": "对于症状明显、药物无效或不能耐受的流出道室性早搏/室速（大部分为特发性），推荐导管消融作为根治性方法。", "supersedes": [], "superseded_by": [], "verified": false, "confidence": "high", "ai_check": "ok"}
{"id": "va_14", "society": "CSC", "doc_title": "室性心律失常中国专家共识", "version": "2020", "effective_date": "2020", "status": "current", "topic": "ventricular_arrhythmia", "section": "致心律失常性右室心肌病（ARVC）一级预防", "class": "IIa", "LOE": "B", "lang": "zh", "citation": "中华医学会心电生理和起搏分会, 中国医师协会心律学专业委员会. 室性心律失常中国专家共识. 2020.", "text": "确诊致心律失常性右室心肌病（ARVC）患者，若存在广泛右室病变、左室受累或不明原因晕厥等高危特征，即使无持续性室速，可考虑植入ICD行一级预防。", "supersedes": [], "superseded_by": [], "verified": false, "confidence": "med", "ai_check": "ok"}
{"id": "va_15", "society": "CSC", "doc_title": "室性心律失常中国专家共识", "version": "2020", "effective_date": "2020", "status": "current", "topic": "ventricular_arrhythmia", "section": "陈旧性心梗合并晕厥电生理指导ICD", "class": "I", "LOE": "B", "lang": "zh", "citation": "中华医学会心电生理和起搏分会, 中国医师协会心律学专业委员会. 室性心律失常中国专家共识. 2020.", "text": "陈旧性心肌梗死患者出现不明原因晕厥，电生理检查诱发持续性单形性室速者，推荐植入ICD。", "supersedes": ["va_16"], "superseded_by": [], "verified": false, "confidence": "high", "ai_check": "ok"}
{"id": "va_16", "society": "CSC", "doc_title": "室性心律失常中国专家共识", "version": "2016", "effective_date": "2016", "status": "superseded", "topic": "ventricular_arrhythmia", "section": "陈旧性心梗合并晕厥电生理指导ICD", "class": "IIa", "LOE": "B", "lang": "zh", "citation": "中华医学会心电生理和起搏分会, 中国医师协会心律学专业委员会. 室性心律失常中国专家共识. 2016.", "text": "陈旧性心肌梗死伴不明原因晕厥，若电生理检查可诱发出持续性室速，可考虑植入ICD。", "supersedes": [], "superseded_by": ["va_15"], "verified": false, "confidence": "low", "ai_check": "ok"}
{"id": "qt_1", "society": "CSC", "doc_title": "2020室性心律失常中国专家共识", "version": "2020", "effective_date": "2020", "status": "current", "topic": "qt_channelopathy", "section": "获得性长QT综合征", "class": "I", "LOE": "C", "lang": "zh", "citation": "中华医学会心电生理和起搏分会, 中国医师协会心律学专业委员会. 2020室性心律失常中国专家共识. 中华心律失常学杂志, 2020, 24(3): 151-183.", "text": "应停用所有可引起QT间期延长的药物，并积极纠正低钾、低镁等电解质紊乱。", "supersedes": [], "superseded_by": [], "verified": false, "confidence": "high", "ai_check": "ok"}
{"id": "qt_2", "society": "CSC", "doc_title": "2020室性心律失常中国专家共识", "version": "2020", "effective_date": "2020", "status": "current", "topic": "qt_channelopathy", "section": "尖端扭转型室速的急性处理", "class": "I", "LOE": "A", "lang": "zh", "citation": "中华医学会心电生理和起搏分会, 中国医师协会心律学专业委员会. 2020室性心律失常中国专家共识. 中华心律失常学杂志, 2020, 24(3): 151-183.", "text": "对于尖端扭转型室速，无论血镁水平如何，均应即刻静脉推注硫酸镁1～2 g。", "supersedes": [], "superseded_by": [], "verified": false, "confidence": "high", "ai_check": "conflict", "ai_note": "共识中该推荐为 I 类 C 级证据（非 A），无随机对照试验支持 A 级；LOE 与指南实际不符。"}
{"id": "qt_3", "society": "CSC", "doc_title": "2020室性心律失常中国专家共识", "version": "2020", "effective_date": "2020", "status": "current", "topic": "qt_channelopathy", "section": "尖端扭转型室速的急性处理", "class": "I", "LOE": "B", "lang": "zh", "citation": "中华医学会心电生理和起搏分会, 中国医师协会心律学专业委员会. 2020室性心律失常中国专家共识. 中华心律失常学杂志, 2020, 24(3): 151-183.", "text": "应通过临时心脏起搏或静脉输注异丙肾上腺素将心室率提升至90次/分以上，以缩短QT间期。", "supersedes": [], "superseded_by": [], "verified": false, "confidence": "high", "ai_check": "conflict", "ai_note": "共识将临时起搏或异丙肾上腺素推荐为 IIa 类、B 级证据，而非 I 类 B 级。"}
{"id": "qt_4", "society": "CSC", "doc_title": "2020室性心律失常中国专家共识", "version": "2020", "effective_date": "2020", "status": "current", "topic": "qt_channelopathy", "section": "尖端扭转型室速的急性处理", "class": "I", "LOE": "C", "lang": "zh", "citation": "中华医学会心电生理和起搏分会, 中国医师协会心律学专业委员会. 2020室性心律失常中国专家共识. 中华心律失常学杂志, 2020, 24(3): 151-183.", "text": "应积极静脉补钾，使血钾水平维持在4.5～5.0 mmol/L。", "supersedes": [], "superseded_by": [], "verified": false, "confidence": "high", "ai_check": "ok"}
{"id": "qt_5", "society": "CSC", "doc_title": "2020室性心律失常中国专家共识", "version": "2020", "effective_date": "2020", "status": "current", "topic": "qt_channelopathy", "section": "先天性长QT综合征", "class": "I", "LOE": "C", "lang": "zh", "citation": "中华医学会心电生理和起搏分会, 中国医师协会心律学专业委员会. 2020室性心律失常中国专家共识. 中华心律失常学杂志, 2020, 24(3): 151-183.", "text": "所有确诊先天性长QT综合征的患者应避免剧烈运动和竞技性运动，并避免可延长QT间期的药物。", "supersedes": [], "superseded_by": [], "verified": false, "confidence": "high", "ai_check": "ok"}
{"id": "qt_6", "society": "CSC", "doc_title": "2020室性心律失常中国专家共识", "version": "2020", "effective_date": "2020", "status": "current", "topic": "qt_channelopathy", "section": "先天性长QT综合征", "class": "I", "LOE": "B", "lang": "zh", "citation": "中华医学会心电生理和起搏分会, 中国医师协会心律学专业委员会. 2020室性心律失常中国专家共识. 中华心律失常学杂志, 2020, 24(3): 151-183.", "text": "β受体阻滞剂（首选普萘洛尔或纳多洛尔）是无症状或仅有晕厥的先天性长QT综合征患者的一线治疗，应使用至目标剂量。", "supersedes": [], "superseded_by": [], "verified": false, "confidence": "high", "ai_check": "ok"}
{"id": "qt_7", "society": "CSC", "doc_title": "2020室性心律失常中国专家共识", "version": "2020", "effective_date": "2020", "status": "current", "topic": "qt_channelopathy", "section": "先天性长QT综合征", "class": "I", "LOE": "B", "lang": "zh", "citation": "中华医学会心电生理和起搏分会, 中国医师协会心律学专业委员会. 2020室性心律失常中国专家共识. 中华心律失常学杂志, 2020, 24(3): 151-183.", "text": "发生过心脏骤停的先天性长QT综合征患者，在排除可逆诱因后应植入心律转复除颤器。", "supersedes": [], "superseded_by": [], "verified": false, "confidence": "high", "ai_check": "ok"}
{"id": "qt_8", "society": "CSC", "doc_title": "2020室性心律失常中国专家共识", "version": "2020", "effective_date": "2020", "status": "current", "topic": "qt_channelopathy", "section": "先天性长QT综合征", "class": "IIa", "LOE": "B", "lang": "zh", "citation": "中华医学会心电生理和起搏分会, 中国医师协会心律学专业委员会. 2020室性心律失常中国专家共识. 中华心律失常学杂志, 2020, 24(3): 151-183.", "text": "对于充分使用β受体阻滞剂后仍反复发生晕厥或不耐受β受体阻滞剂的高危患者，可行左心交感神经切除术。", "supersedes": [], "superseded_by": [], "verified": false, "confidence": "high", "ai_check": "ok"}
{"id": "qt_9", "society": "CSC", "doc_title": "2020室性心律失常中国专家共识", "version": "2020", "effective_date": "2020", "status": "current", "topic": "qt_channelopathy", "section": "Brugada综合征", "class": "I", "LOE": "B", "lang": "zh", "citation": "中华医学会心电生理和起搏分会, 中国医师协会心律学专业委员会. 2020室性心律失常中国专家共识. 中华心律失常学杂志, 2020, 24(3): 151-183.", "text": "既往有心脏骤停或记录到持续性室速的Brugada综合征患者，应植入心律转复除颤器。", "supersedes": [], "superseded_by": [], "verified": false, "confidence": "high", "ai_check": "ok"}
{"id": "qt_10", "society": "CSC", "doc_title": "Brugada综合征中国专家共识", "version": "2013", "effective_date": "2013", "status": "superseded", "topic": "qt_channelopathy", "section": "Brugada综合征", "class": "IIa", "LOE": "C", "lang": "zh", "citation": "中华医学会心血管病学分会, 中华心血管病杂志编辑委员会. Brugada综合征中国专家共识. 中华心血管病杂志, 2013, 41(2): 97-103.", "text": "对于无症状、自发型Ⅰ型心电图改变且心脏电生理检查可诱发出室颤的患者，可考虑植入心律转复除颤器。", "supersedes": [], "superseded_by": ["qt_11"], "verified": false, "confidence": "high", "ai_check": "ok"}
{"id": "qt_11", "society": "CSC", "doc_title": "2020室性心律失常中国专家共识", "version": "2020", "effective_date": "2020", "status": "current", "topic": "qt_channelopathy", "section": "Brugada综合征", "class": "IIb", "LOE": "C", "lang": "zh", "citation": "中华医学会心电生理和起搏分会, 中国医师协会心律学专业委员会. 2020室性心律失常中国专家共识. 中华心律失常学杂志, 2020, 24(3): 151-183.", "text": "对于无症状、自发型Ⅰ型Brugada心电图改变且心脏程序刺激可诱发出室颤的患者，植入心律转复除颤器的推荐级别已下调，可以考虑。", "supersedes": ["qt_10"], "superseded_by": [], "verified": false, "confidence": "high", "ai_check": "ok"}
{"id": "stemi_1", "society": "CSC", "doc_title": "急性ST段抬高型心肌梗死诊断和治疗指南(2015)", "version": "2015", "effective_date": "2015", "status": "superseded", "topic": "ischemia_stemi", "section": "再灌注治疗", "class": "I", "LOE": "A", "lang": "zh", "citation": "中华医学会心血管病学分会. 急性ST段抬高型心肌梗死诊断和治疗指南(2015).", "text": "对于发病12小时内的STEMI患者，应尽早行直接PCI，要求首次医疗接触至球囊扩张（FMC‑to‑balloon）时间<90分钟。", "supersedes": [], "superseded_by": ["stemi_2"], "verified": false, "confidence": "high", "ai_check": "ok"}
{"id": "stemi_2", "society": "CSC", "doc_title": "急性ST段抬高型心肌梗死诊断和治疗指南(2019)", "version": "2019", "effective_date": "2019", "status": "current", "topic": "ischemia_stemi", "section": "再灌注治疗", "class": "I", "LOE": "A", "lang": "zh", "citation": "中华医学会心血管病学分会. 急性ST段抬高型心肌梗死诊断和治疗指南(2019).", "text": "对于发病12小时内的STEMI患者，推荐直接PCI，要求首次医疗接触至导丝通过梗死相关动脉（wire crossing）时间≤90分钟。", "supersedes": ["stemi_1"], "superseded_by": [], "verified": false, "confidence": "high", "ai_check": "ok"}
{"id": "stemi_3", "society": "CSC", "doc_title": "急性ST段抬高型心肌梗死诊断和治疗指南(2019)", "version": "2019", "effective_date": "2019", "status": "current", "topic": "ischemia_stemi", "section": "溶栓治疗", "class": "I", "LOE": "A", "lang": "zh", "citation": "中华医学会心血管病学分会. 急性ST段抬高型心肌梗死诊断和治疗指南(2019).", "text": "对发病<3小时且无法在120分钟内行直接PCI的STEMI患者，若无禁忌证，应在入院后30分钟内启动溶栓治疗。", "supersedes": [], "superseded_by": [], "verified": false, "confidence": "high", "ai_check": "ok"}
{"id": "stemi_4", "society": "CSC", "doc_title": "急性ST段抬高型心肌梗死诊断和治疗指南(2019)", "version": "2019", "effective_date": "2019", "status": "current", "topic": "ischemia_stemi", "section": "转运PCI", "class": "I", "LOE": "A", "lang": "zh", "citation": "中华医学会心血管病学分会. 急性ST段抬高型心肌梗死诊断和治疗指南(2019).", "text": "就诊于不具备直接PCI条件医院的患者，如溶栓禁忌或溶栓失败，应急诊转运至有PCI条件的医院行补救PCI。", "supersedes": [], "superseded_by": [], "verified": false, "confidence": "high", "ai_check": "ok"}
{"id": "stemi_5", "society": "CSC", "doc_title": "急性ST段抬高型心肌梗死诊断和治疗指南(2019)", "version": "2019", "effective_date": "2019", "status": "current", "topic": "ischemia_stemi", "section": "抗血小板治疗", "class": "I", "LOE": "A", "lang": "zh", "citation": "中华医学会心血管病学分会. 急性ST段抬高型心肌梗死诊断和治疗指南(2019).", "text": "所有行直接PCI的STEMI患者，术前应尽早给予阿司匹林300 mg联合替格瑞洛180 mg（或氯吡格雷600 mg）双联抗血小板负荷剂量。", "supersedes": [], "superseded_by": [], "verified": false, "confidence": "high", "ai_check": "ok"}
{"id": "stemi_6", "society": "CSC", "doc_title": "急性ST段抬高型心肌梗死诊断和治疗指南(2019)", "version": "2019", "effective_date": "2019", "status": "current", "topic": "ischemia_stemi", "section": "抗凝治疗", "class": "I", "LOE": "A", "lang": "zh", "citation": "中华医学会心血管病学分会. 急性ST段抬高型心肌梗死诊断和治疗指南(2019).", "text": "直接PCI术中推荐使用比伐卢定或普通肝素进行抗凝治疗。", "supersedes": [], "superseded_by": [], "verified": false, "confidence": "high", "ai_check": "ok"}
{"id": "stemi_7", "society": "CSC", "doc_title": "非ST段抬高型急性冠状动脉综合征诊断和治疗指南(2016)", "version": "2016", "effective_date": "2016", "status": "current", "topic": "ischemia_stemi", "section": "危险分层", "class": "I", "LOE": "B", "lang": "zh", "citation": "中华医学会心血管病学分会. 非ST段抬高型急性冠状动脉综合征诊断和治疗指南(2016).", "text": "推荐采用全球急性冠状动脉事件注册(GRACE)评分对NSTE‑ACS患者进行缺血风险评估。", "supersedes": [], "superseded_by": [], "verified": false, "confidence": "high", "ai_check": "ok"}
{"id": "stemi_8", "society": "CSC", "doc_title": "非ST段抬高型急性冠状动脉综合征诊断和治疗指南(2016)", "version": "2016", "effective_date": "2016", "status": "current", "topic": "ischemia_stemi", "section": "侵入治疗时机", "class": "I", "LOE": "C", "lang": "zh", "citation": "中华医学会心血管病学分会. 非ST段抬高型急性冠状动脉综合征诊断和治疗指南(2016).", "text": "对极高危患者(如难治性心绞痛、心力衰竭、血流动力学不稳定或恶性心律失常)，应在2小时内行紧急侵入治疗。", "supersedes": [], "superseded_by": [], "verified": false, "confidence": "high", "ai_check": "ok"}
{"id": "stemi_9", "society": "CSC", "doc_title": "非ST段抬高型急性冠状动脉综合征诊断和治疗指南(2016)", "version": "2016", "effective_date": "2016", "status": "current", "topic": "ischemia_stemi", "section": "侵入治疗时机", "class": "I", "LOE": "A", "lang": "zh", "citation": "中华医学会心血管病学分会. 非ST段抬高型急性冠状动脉综合征诊断和治疗指南(2016).", "text": "对高危患者(GRACE评分>140)，推荐在24小时内行早期侵入治疗。", "supersedes": [], "superseded_by": [], "verified": false, "confidence": "high", "ai_check": "ok"}
{"id": "stemi_10", "society": "CSC", "doc_title": "非ST段抬高型急性冠状动脉综合征诊断和治疗指南(2016)", "version": "2016", "effective_date": "2016", "status": "current", "topic": "ischemia_stemi", "section": "侵入治疗时机", "class": "I", "LOE": "A", "lang": "zh", "citation": "中华医学会心血管病学分会. 非ST段抬高型急性冠状动脉综合征诊断和治疗指南(2016).", "text": "对中危患者(GRACE评分109~140)，推荐在72小时内行侵入治疗。", "supersedes": [], "superseded_by": [], "verified": false, "confidence": "low", "ai_check": "ok"}
{"id": "stemi_11", "society": "CSC", "doc_title": "非ST段抬高型急性冠状动脉综合征诊断和治疗指南(2016)", "version": "2016", "effective_date": "2016", "status": "current", "topic": "ischemia_stemi", "section": "侵入治疗与否", "class": "I", "LOE": "A", "lang": "zh", "citation": "中华医学会心血管病学分会. 非ST段抬高型急性冠状动脉综合征诊断和治疗指南(2016).", "text": "对低危患者(GRACE评分≤108)，建议先行无创负荷试验，若证实缺血再考虑侵入检查。", "supersedes": [], "superseded_by": [], "verified": false, "confidence": "high", "ai_check": "conflict", "ai_note": "2016版NSTE‑ACS指南对低危患者（GRACE≤108）推荐无创检查的级别为I类，但证据级别应为B（源自观察性研究），而非A。"}
{"id": "stemi_12", "society": "CSC", "doc_title": "急性ST段抬高型心肌梗死诊断和治疗指南(2019)", "version": "2019", "effective_date": "2019", "status": "current", "topic": "ischemia_stemi", "section": "二级预防", "class": "I", "LOE": "A", "lang": "zh", "citation": "中华医学会心血管病学分会. 急性ST段抬高型心肌梗死诊断和治疗指南(2019).", "text": "所有STEMI患者均应接受阿司匹林联合一种P2Y12受体抑制剂的双联抗血小板治疗，疗程至少12个月。", "supersedes": [], "superseded_by": [], "verified": false, "confidence": "high", "ai_check": "ok"}
{"id": "stemi_13", "society": "CSC", "doc_title": "急性ST段抬高型心肌梗死诊断和治疗指南(2019)", "version": "2019", "effective_date": "2019", "status": "current", "topic": "ischemia_stemi", "section": "二级预防", "class": "I", "LOE": "A", "lang": "zh", "citation": "中华医学会心血管病学分会. 急性ST段抬高型心肌梗死诊断和治疗指南(2019).", "text": "患者应尽早启动并长期维持强化他汀治疗，使LDL‑C<1.8 mmol/L或较基线下降幅度≥50%。", "supersedes": [], "superseded_by": [], "verified": false, "confidence": "high", "ai_check": "ok"}
{"id": "stemi_14", "society": "CSC", "doc_title": "急性ST段抬高型心肌梗死诊断和治疗指南(2019)", "version": "2019", "effective_date": "2019", "status": "current", "topic": "ischemia_stemi", "section": "二级预防", "class": "I", "LOE": "A", "lang": "zh", "citation": "中华医学会心血管病学分会. 急性ST段抬高型心肌梗死诊断和治疗指南(2019).", "text": "前壁心肌梗死、心力衰竭或LVEF≤40%的患者，应在24小时内启用ACEI治疗，不耐受者以ARB替代。", "supersedes": [], "superseded_by": [], "verified": false, "confidence": "high", "ai_check": "ok"}
{"id": "stemi_15", "society": "CSC", "doc_title": "急性ST段抬高型心肌梗死诊断和治疗指南(2019)", "version": "2019", "effective_date": "2019", "status": "current", "topic": "ischemia_stemi", "section": "二级预防", "class": "I", "LOE": "A", "lang": "zh", "citation": "中华医学会心血管病学分会. 急性ST段抬高型心肌梗死诊断和治疗指南(2019).", "text": "无禁忌证(如心衰、低输出量或心原性休克)的STEMI患者，应在发病24小时内启动并长期口服β受体阻滞剂。", "supersedes": [], "superseded_by": [], "verified": false, "confidence": "high", "ai_check": "conflict", "ai_note": "2019版STEMI指南对无禁忌证者早期口服β受体阻滞剂的证据级别为B（基于观察性研究），而非A。"}
{"id": "stemi_16", "society": "CSC", "doc_title": "急性ST段抬高型心肌梗死诊断和治疗指南(2019)", "version": "2019", "effective_date": "2019", "status": "current", "topic": "ischemia_stemi", "section": "二级预防", "class": "I", "LOE": "A", "lang": "zh", "citation": "中华医学会心血管病学分会. 急性ST段抬高型心肌梗死诊断和治疗指南(2019).", "text": "LVEF≤40%并合并心力衰竭或糖尿病的STEMI患者，应加用醛固酮受体拮抗剂(如螺内酯)。", "supersedes": [], "superseded_by": [], "verified": false, "confidence": "high", "ai_check": "ok"}
{"id": "stemi_17", "society": "CSC", "doc_title": "急性ST段抬高型心肌梗死诊断和治疗指南(2019)", "version": "2019", "effective_date": "2019", "status": "current", "topic": "ischemia_stemi", "section": "二级预防", "class": "I", "LOE": "B", "lang": "zh", "citation": "中华医学会心血管病学分会. 急性ST段抬高型心肌梗死诊断和治疗指南(2019).", "text": "推荐所有心肌梗死患者参与心脏康复并完成戒烟干预。", "supersedes": [], "superseded_by": [], "verified": false, "confidence": "high", "ai_check": "conflict", "ai_note": "2019版指南将心脏康复（I，A）与戒烟（I，B）分列为独立推荐；本条合并并统一定为I/B，改变了心脏康复的证据级别，属张冠李戴。"}
{"id": "stemi_18", "society": "CSC", "doc_title": "急性ST段抬高型心肌梗死诊断和治疗指南(2019)", "version": "2019", "effective_date": "2019", "status": "current", "topic": "ischemia_stemi", "section": "再灌注策略", "class": "I", "LOE": "A", "lang": "zh", "citation": "中华医学会心血管病学分会. 急性ST段抬高型心肌梗死诊断和治疗指南(2019).", "text": "溶栓治疗成功后，建议在3~24小时内行冠状动脉造影，必要时行PCI（药物侵入策略）。", "supersedes": [], "superseded_by": [], "verified": false, "confidence": "high", "ai_check": "ok"}
{"id": "stemi_19", "society": "CSC", "doc_title": "急性ST段抬高型心肌梗死诊断和治疗指南(2019)", "version": "2019", "effective_date": "2019", "status": "current", "topic": "ischemia_stemi", "section": "再灌注治疗", "class": "I", "LOE": "B", "lang": "zh", "citation": "中华医学会心血管病学分会. 急性ST段抬高型心肌梗死诊断和治疗指南(2019).", "text": "合并心源性休克的STEMI患者，无论时间延误，均应紧急行直接PCI或急诊CABG。", "supersedes": [], "superseded_by": [], "verified": false, "confidence": "high", "ai_check": "ok"}
{"id": "stemi_20", "society": "CSC", "doc_title": "非ST段抬高型急性冠状动脉综合征诊断和治疗指南(2016)", "version": "2016", "effective_date": "2016", "status": "current", "topic": "ischemia_stemi", "section": "抗血小板治疗", "class": "I", "LOE": "B", "lang": "zh", "citation": "中华医学会心血管病学分会. 非ST段抬高型急性冠状动脉综合征诊断和治疗指南(2016).", "text": "所有NSTE‑ACS患者应立即给予阿司匹林300 mg联合替格瑞洛180 mg(或氯吡格雷600 mg)口服双联抗血小板负荷治疗。", "supersedes": [], "superseded_by": [], "verified": false, "confidence": "high", "ai_check": "conflict", "ai_note": "2016版NSTE‑ACS指南对立即双联抗血小板负荷治疗（阿司匹林+替格瑞洛/氯吡格雷）推荐为I类A级，非B级。"}
{"id": "svt_1", "society": "CSC", "doc_title": "室上性心动过速诊断及治疗中国专家共识(2021)", "version": "2021", "effective_date": "2021", "status": "current", "topic": "svt", "section": "急性期处理", "class": "I", "LOE": "B", "lang": "zh", "citation": "中国医师协会心律学专业委员会《室上性心动过速诊断及治疗中国专家共识(2021)》", "text": "对于血流动力学稳定的窄QRS波室上性心动过速，推荐首先尝试Valsalva动作或颈动脉窦按摩等迷走神经刺激法终止心动过速。", "supersedes": [], "superseded_by": [], "verified": false, "confidence": "high", "ai_check": "ok"}
{"id": "svt_2", "society": "CSC", "doc_title": "室上性心动过速诊断及治疗中国专家共识(2021)", "version": "2021", "effective_date": "2021", "status": "current", "topic": "svt", "section": "急性期处理", "class": "I", "LOE": "A", "lang": "zh", "citation": "中国医师协会心律学专业委员会《室上性心动过速诊断及治疗中国专家共识(2021)》", "text": "迷走神经刺激无效的窄QRS波室上速，首选静脉快速推注腺苷（或三磷酸腺苷）进行终止，应在心电监护和除颤仪备用下进行。", "supersedes": [], "superseded_by": [], "verified": false, "confidence": "high", "ai_check": "ok"}
{"id": "svt_3", "society": "CSC", "doc_title": "室上性心动过速诊断及治疗中国专家共识(2021)", "version": "2021", "effective_date": "2021", "status": "current", "topic": "svt", "section": "急性期处理", "class": "I", "LOE": "B", "lang": "zh", "citation": "中国医师协会心律学专业委员会《室上性心动过速诊断及治疗中国专家共识(2021)》", "text": "若腺苷无效或存在禁忌，可静脉注射维拉帕米或地尔硫卓以终止房室结折返性心动过速和房室折返性心动过速。", "supersedes": [], "superseded_by": [], "verified": false, "confidence": "high", "ai_check": "ok"}
{"id": "svt_4", "society": "CSC", "doc_title": "室上性心动过速诊断及治疗中国专家共识(2021)", "version": "2021", "effective_date": "2021", "status": "current", "topic": "svt", "section": "急性期处理", "class": "I", "LOE": "C", "lang": "zh", "citation": "中国医师协会心律学专业委员会《室上性心动过速诊断及治疗中国专家共识(2021)》", "text": "对血流动力学不稳定的室上速（如出现低血压、休克、缺血性胸痛、心力衰竭等），应立即行同步直流电复律，首次能量建议50-100 J。", "supersedes": [], "superseded_by": [], "verified": false, "confidence": "high", "ai_check": "ok"}
{"id": "svt_5", "society": "CSC", "doc_title": "室上性心动过速诊断及治疗中国专家共识(2021)", "version": "2021", "effective_date": "2021", "status": "current", "topic": "svt", "section": "预激综合征（WPW）处理", "class": "III", "LOE": "C", "lang": "zh", "citation": "中国医师协会心律学专业委员会《室上性心动过速诊断及治疗中国专家共识(2021)》", "text": "预激综合征合并心房颤动时，应避免使用可能加速旁路传导的药物，如地高辛、维拉帕米、地尔硫卓及静脉腺苷，以防诱发心室颤动。", "supersedes": [], "superseded_by": [], "verified": false, "confidence": "high", "ai_check": "ok"}
{"id": "svt_6", "society": "CSC", "doc_title": "室上性心动过速诊断及治疗中国专家共识(2021)", "version": "2021", "effective_date": "2021", "status": "current", "topic": "svt", "section": "预激综合征（WPW）处理", "class": "I", "LOE": "C", "lang": "zh", "citation": "中国医师协会心律学专业委员会《室上性心动过速诊断及治疗中国专家共识(2021)》", "text": "预激综合征伴心房颤动且血流动力学不稳定者，应立即行同步直流电复律。", "supersedes": [], "superseded_by": [], "verified": false, "confidence": "high", "ai_check": "ok"}
{"id": "svt_7", "society": "CSC", "doc_title": "室上性心动过速诊断及治疗中国专家共识(2021)", "version": "2021", "effective_date": "2021", "status": "current", "topic": "svt", "section": "导管消融", "class": "I", "LOE": "A", "lang": "zh", "citation": "中国医师协会心律学专业委员会《室上性心动过速诊断及治疗中国专家共识(2021)》", "text": "对于有症状、反复发作的房室结折返性心动过速（AVNRT），导管消融作为一线治疗推荐，具有高成功率和低并发症风险。", "supersedes": [], "superseded_by": [], "verified": false, "confidence": "high", "ai_check": "ok"}
{"id": "svt_8", "society": "CSC", "doc_title": "室上性心动过速诊断及治疗中国专家共识(2021)", "version": "2021", "effective_date": "2021", "status": "current", "topic": "svt", "section": "导管消融", "class": "I", "LOE": "A", "lang": "zh", "citation": "中国医师协会心律学专业委员会《室上性心动过速诊断及治疗中国专家共识(2021)》", "text": "对于有症状、反复发作的房室折返性心动过速（AVRT），即显性预激综合征，推荐导管消融旁路作为首选治疗。", "supersedes": [], "superseded_by": [], "verified": false, "confidence": "high", "ai_check": "ok"}
{"id": "svt_9", "society": "CSC", "doc_title": "室上性心动过速诊断及治疗中国专家共识(2021)", "version": "2021", "effective_date": "2021", "status": "current", "topic": "svt", "section": "导管消融", "class": "IIa", "LOE": "B", "lang": "zh", "citation": "中国医师协会心律学专业委员会《室上性心动过速诊断及治疗中国专家共识(2021)》", "text": "无症状预激综合征患者，若从事高危职业或电生理检查提示旁路前传不应期短、可诱发房室折返性心动过速或心房颤动，导管消融是合理的。", "supersedes": [], "superseded_by": [], "verified": false, "confidence": "high", "ai_check": "ok"}
{"id": "svt_10", "society": "CSC", "doc_title": "室上性心动过速诊断及治疗中国专家共识(2021)", "version": "2021", "effective_date": "2021", "status": "current", "topic": "svt", "section": "长期药物治疗", "class": "IIb", "LOE": "B", "lang": "zh", "citation": "中国医师协会心律学专业委员会《室上性心动过速诊断及治疗中国专家共识(2021)》", "text": "对于拒绝导管消融或存在手术禁忌的症状性AVNRT患者，可长期口服维拉帕米或地尔硫卓以减少心动过速复发。", "supersedes": [], "superseded_by": [], "verified": false, "confidence": "high", "ai_check": "conflict", "ai_note": "2021共识对拒绝消融的症状性AVNRT长期口服维拉帕米/地尔硫卓推荐为IIa类B级，非IIb。"}
{"id": "svt_11", "society": "CSC", "doc_title": "室上性心动过速诊断及治疗中国专家共识(2021)", "version": "2021", "effective_date": "2021", "status": "current", "topic": "svt", "section": "长期药物治疗", "class": "IIb", "LOE": "B", "lang": "zh", "citation": "中国医师协会心律学专业委员会《室上性心动过速诊断及治疗中国专家共识(2021)》", "text": "对于拒绝消融或不可消除的房室折返性心动过速，可择用普罗帕酮或索他洛尔作为长期预防用药，但需警惕致心律失常风险。", "supersedes": [], "superseded_by": [], "verified": false, "confidence": "high", "ai_check": "conflict", "ai_note": "2021共识对拒绝消融的AVRT长期使用普罗帕酮/索他洛尔推荐为IIa类B级，非IIb。"}
{"id": "svt_12", "society": "CSC", "doc_title": "室上性心动过速中国专家共识(2016)", "version": "2016", "effective_date": "2016", "status": "superseded", "topic": "svt", "section": "导管消融", "class": "IIb", "LOE": "B", "lang": "zh", "citation": "中国医师协会心律学专业委员会《室上性心动过速中国专家共识(2016)》", "text": "对于仅记录到不频繁发作、症状轻微的AVNRT，导管消融可能被列为备选方案，优先选择药物治疗或临床观察。", "supersedes": [], "superseded_by": ["svt_13"], "verified": false, "confidence": "low", "ai_check": "ok"}
{"id": "svt_13", "society": "CSC", "doc_title": "室上性心动过速诊断及治疗中国专家共识(2021)", "version": "2021", "effective_date": "2021", "status": "current", "topic": "svt", "section": "导管消融", "class": "IIa", "LOE": "C", "lang": "zh", "citation": "中国医师协会心律学专业委员会《室上性心动过速诊断及治疗中国专家共识(2021)》", "text": "对于记录到不频繁发作但有明确心电证据的症状性AVNRT，若患者倾向于根治治疗，导管消融可作为合理的一线选择，推荐强度较前有所提升。", "supersedes": ["svt_12"], "superseded_by": [], "verified": false, "confidence": "low", "ai_check": "ok"}
{"id": "elyte_1", "society": "CSC", "doc_title": "中国心力衰竭患者离子管理专家共识", "version": "2020", "effective_date": "2020", "status": "current", "topic": "electrolyte", "section": "高钾血症", "class": "I", "LOE": "C", "lang": "zh", "citation": "中华医学会心血管病学分会心力衰竭学组《中国心力衰竭患者离子管理专家共识》2020", "text": "高钾血症的心电图改变包括T波高尖、PR间期延长、QRS波群增宽，甚至出现正弦波，一旦发现上述心电图特征应立即进行评估与干预。", "supersedes": [], "superseded_by": [], "verified": false, "confidence": "high", "ai_check": "ok"}
{"id": "elyte_2", "society": "CSC", "doc_title": "中国心力衰竭患者离子管理专家共识", "version": "2020", "effective_date": "2020", "status": "current", "topic": "electrolyte", "section": "高钾血症", "class": "I", "LOE": "C", "lang": "zh", "citation": "中华医学会心血管病学分会心力衰竭学组《中国心力衰竭患者离子管理专家共识》2020", "text": "对于高钾血症伴心电图异常者，应立即静脉注射10%葡萄糖酸钙10～20 ml以拮抗高钾对心肌细胞膜的毒性作用，必要时可重复。", "supersedes": [], "superseded_by": [], "verified": false, "confidence": "high", "ai_check": "ok"}
{"id": "elyte_3", "society": "CSC", "doc_title": "中国心力衰竭患者离子管理专家共识", "version": "2020", "effective_date": "2020", "status": "current", "topic": "electrolyte", "section": "高钾血症", "class": "I", "LOE": "C", "lang": "zh", "citation": "中华医学会心血管病学分会心力衰竭学组《中国心力衰竭患者离子管理专家共识》2020", "text": "在心电图异常高钾血症的紧急降钾中，应同时使用胰岛素联合葡萄糖、静脉碳酸氢钠等促进钾离子向细胞内转移，并配合利尿剂或透析等排钾措施。", "supersedes": [], "superseded_by": [], "verified": false, "confidence": "high", "ai_check": "ok"}
{"id": "elyte_4", "society": "CSC", "doc_title": "中国心力衰竭患者离子管理专家共识", "version": "2020", "effective_date": "2020", "status": "current", "topic": "electrolyte", "section": "低钾血症", "class": "I", "LOE": "B", "lang": "zh", "citation": "中华医学会心血管病学分会心力衰竭学组《中国心力衰竭患者离子管理专家共识》2020", "text": "低钾血症心电图可表现为T波低平、U波增高、ST段压低及QT间期延长，出现上述改变时应及时评估并开始补钾。", "supersedes": [], "superseded_by": [], "verified": false, "confidence": "high", "ai_check": "ok"}
{"id": "elyte_5", "society": "CSC", "doc_title": "中国心力衰竭患者离子管理专家共识", "version": "2020", "effective_date": "2020", "status": "current", "topic": "electrolyte", "section": "低钾血症", "class": "I", "LOE": "B", "lang": "zh", "citation": "中华医学会心血管病学分会心力衰竭学组《中国心力衰竭患者离子管理专家共识》2020", "text": "严重低钾血症（血钾<2.5 mmol/L或伴心律失常/心电图明显异常）应通过静脉途径补钾，并持续心电监护，补钾速度一般不超过0.5 mmol/kg/h。", "supersedes": [], "superseded_by": [], "verified": false, "confidence": "high", "ai_check": "ok"}
{"id": "elyte_6", "society": "CSC", "doc_title": "中国心力衰竭患者离子管理专家共识", "version": "2020", "effective_date": "2020", "status": "current", "topic": "electrolyte", "section": "高钙血症", "class": "IIa", "LOE": "C", "lang": "zh", "citation": "中华医学会心血管病学分会心力衰竭学组《中国心力衰竭患者离子管理专家共识》2020", "text": "高钙血症时心电图典型表现为QT间期缩短，严重时可致心律失常，应警惕并同时监测血钙浓度。", "supersedes": [], "superseded_by": [], "verified": false, "confidence": "low", "ai_check": "ok"}
{"id": "elyte_7", "society": "CSC", "doc_title": "中国心力衰竭患者离子管理专家共识", "version": "2020", "effective_date": "2020", "status": "current", "topic": "electrolyte", "section": "低钙血症", "class": "IIa", "LOE": "C", "lang": "zh", "citation": "中华医学会心血管病学分会心力衰竭学组《中国心力衰竭患者离子管理专家共识》2020", "text": "低钙血症可见QT间期延长及ST段延长，心电图改变有助于早期识别并结合血钙水平进行干预。", "supersedes": [], "superseded_by": [], "verified": false, "confidence": "low", "ai_check": "ok"}
{"id": "elyte_8", "society": "CSC", "doc_title": "中国心力衰竭患者离子管理专家共识", "version": "2020", "effective_date": "2020", "status": "current", "topic": "electrolyte", "section": "低镁血症", "class": "I", "LOE": "B", "lang": "zh", "citation": "中华医学会心血管病学分会心力衰竭学组《中国心力衰竭患者离子管理专家共识》2020", "text": "低镁血症的心电图表现类似低钾，可诱发尖端扭转型室性心动过速，对于有心律失常风险的患者应将血镁维持在0.8 mmol/L以上，必要时静脉补充硫酸镁。", "supersedes": [], "superseded_by": [], "verified": false, "confidence": "high", "ai_check": "ok"}
{"id": "elyte_9", "society": "CSC", "doc_title": "洋地黄类药物临床应用中国专家共识", "version": "2014", "effective_date": "2014", "status": "superseded", "topic": "electrolyte", "section": "洋地黄中毒", "class": "IIa", "LOE": "C", "lang": "zh", "citation": "中华医学会心血管病学分会《洋地黄类药物临床应用中国专家共识》2014", "text": "洋地黄中毒心电图特征为室性期前收缩二联律、非阵发性交界性心动过速伴房室传导阻滞、双向性室速等，处理包括立即停药、补钾补镁及抗心律失常。", "supersedes": [], "superseded_by": ["elyte_10"], "verified": false, "confidence": "high", "ai_check": "conflict", "ai_note": "所引《洋地黄类药物临床应用中国专家共识》2014版未采用class/LOE分级系统，无法赋予IIa/C，属人为添加推荐类别，与指南实际推荐不符。"}
{"id": "elyte_10", "society": "CSC", "doc_title": "洋地黄类药物临床应用中国专家共识", "version": "2023", "effective_date": "2023", "status": "current", "topic": "electrolyte", "section": "洋地黄中毒", "class": "I", "LOE": "C", "lang": "zh", "citation": "中华医学会心血管病学分会《洋地黄类药物临床应用中国专家共识》2023", "text": "洋地黄中毒时出现室性心律失常或高度房室传导阻滞等心电图改变，应立即停用洋地黄、纠正电解质紊乱（低钾、低镁），并持续心电监测。", "supersedes": ["elyte_9"], "superseded_by": [], "verified": false, "confidence": "high", "ai_check": "ok"}
{"id": "elyte_11", "society": "CSC", "doc_title": "洋地黄类药物临床应用中国专家共识", "version": "2014", "effective_date": "2014", "status": "superseded", "topic": "electrolyte", "section": "洋地黄中毒", "class": "IIa", "LOE": "B", "lang": "zh", "citation": "中华医学会心血管病学分会《洋地黄类药物临床应用中国专家共识》2014", "text": "对于危及生命的洋地黄中毒（如恶性室性心律失常、心搏骤停），可考虑使用地高辛特异性抗体Fab片段。", "supersedes": [], "superseded_by": ["elyte_12"], "verified": false, "confidence": "high", "ai_check": "conflict", "ai_note": "2014版洋地黄共识无class/LOE分级体系，声明IIa/B不符合所引指南实际推荐。"}
{"id": "elyte_12", "society": "CSC", "doc_title": "洋地黄类药物临床应用中国专家共识", "version": "2023", "effective_date": "2023", "status": "current", "topic": "electrolyte", "section": "洋地黄中毒", "class": "I", "LOE": "B", "lang": "zh", "citation": "中华医学会心血管病学分会《洋地黄类药物临床应用中国专家共识》2023", "text": "对于洋地黄中毒导致的血流动力学不稳定的致命性心律失常，应尽早使用地高辛特异性抗体Fab片段。", "supersedes": ["elyte_11"], "superseded_by": [], "verified": false, "confidence": "high", "ai_check": "ok"}
{"id": "hcm_1", "society": "CSC", "doc_title": "中国成人肥厚型心肌病诊断与治疗指南", "version": "2023", "effective_date": "2023", "status": "current", "topic": "hypertrophy_cardiomyopathy", "section": "左室肥厚评估", "class": "I", "LOE": "B", "lang": "zh", "citation": "中华医学会心血管病学分会, 等. 中国成人肥厚型心肌病诊断与治疗指南. 2023.", "text": "经胸超声心动图是评估左心室壁厚度的首选影像学方法，推荐用于左室肥厚的初始评估。", "supersedes": [], "superseded_by": [], "verified": false, "confidence": "high", "ai_check": "ok"}
{"id": "hcm_2", "society": "CSC", "doc_title": "中国成人肥厚型心肌病诊断与治疗指南", "version": "2023", "effective_date": "2023", "status": "current", "topic": "hypertrophy_cardiomyopathy", "section": "左室肥厚评估", "class": "I", "LOE": "C", "lang": "zh", "citation": "中华医学会心血管病学分会, 等. 中国成人肥厚型心肌病诊断与治疗指南. 2023.", "text": "诊断左室肥厚时需全面排除高血压、主动脉瓣狭窄等继发性原因，对病因不明者推荐行心脏磁共振成像以提供更精确的室壁厚度和组织特征信息。", "supersedes": [], "superseded_by": [], "verified": false, "confidence": "high", "ai_check": "ok"}
{"id": "hcm_3", "society": "CSC", "doc_title": "中国成人肥厚型心肌病诊断与治疗指南", "version": "2023", "effective_date": "2023", "status": "current", "topic": "hypertrophy_cardiomyopathy", "section": "HCM诊断", "class": "I", "LOE": "C", "lang": "zh", "citation": "中华医学会心血管病学分会, 等. 中国成人肥厚型心肌病诊断与治疗指南. 2023.", "text": "成人肥厚型心肌病的诊断标准为任何影像学证实左心室一个或多个节段室壁厚度≥15 мм，且排除后负荷增加或其他系统性疾病所致；如伴有明确家族史或致病基因突变，≥13 mm亦可诊断。", "supersedes": [], "superseded_by": [], "verified": false, "confidence": "high", "ai_check": "ok"}
{"id": "hcm_4", "society": "CSC", "doc_title": "中国成人肥厚型心肌病诊断与治疗指南", "version": "2023", "effective_date": "2023", "status": "current", "topic": "hypertrophy_cardiomyopathy", "section": "HCM诊断", "class": "I", "LOE": "B", "lang": "zh", "citation": "中华医学会心血管病学分会, 等. 中国成人肥厚型心肌病诊断与治疗指南. 2023.", "text": "建议对临床确诊的肥厚型心肌病患者进行遗传咨询和基因检测，并对其一级亲属进行临床与遗传家系筛查。", "supersedes": [], "superseded_by": [], "verified": false, "confidence": "high", "ai_check": "ok"}
{"id": "hcm_5", "society": "CSC", "doc_title": "中国成人肥厚型心肌病诊断与治疗指南", "version": "2023", "effective_date": "2023", "status": "current", "topic": "hypertrophy_cardiomyopathy", "section": "猝死风险评估与ICD一级预防", "class": "IIa", "LOE": "B", "lang": "zh", "citation": "中华医学会心血管病学分会, 等. 中国成人肥厚型心肌病诊断与治疗指南. 2023.", "text": "对于左心室射血分数<50%的肥厚型心肌病患者，应考虑植入埋藏式心脏转复除颤器进行一级预防。", "supersedes": [], "superseded_by": [], "verified": false, "confidence": "high", "ai_check": "ok"}
{"id": "hcm_6", "society": "CSC", "doc_title": "中国成人肥厚型心肌病诊断与治疗指南", "version": "2023", "effective_date": "2023", "status": "current", "topic": "hypertrophy_cardiomyopathy", "section": "流出道梗阻药物治疗", "class": "I", "LOE": "B", "lang": "zh", "citation": "中华医学会心血管病学分会, 等. 中国成人肥厚型心肌病诊断与治疗指南. 2023.", "text": "对于有症状的左心室流出道梗阻患者，推荐使用无血管扩张作用的β受体阻滞剂（如美托洛尔缓释片）作为一线治疗；若β受体阻滞剂无效或存在禁忌，可换用维拉帕米或地尔硫卓。", "supersedes": [], "superseded_by": [], "verified": false, "confidence": "high", "ai_check": "conflict", "ai_note": "2023指南中维拉帕米为I类B级、地尔硫卓为I类C级，此处合并给药且统标I, B，高估地尔硫卓证据水平，不符合指南实际推荐。"}
{"id": "hcm_7", "society": "CSC", "doc_title": "中国成人肥厚型心肌病诊断与治疗指南", "version": "2023", "effective_date": "2023", "status": "current", "topic": "hypertrophy_cardiomyopathy", "section": "室间隔减容治疗", "class": "I", "LOE": "B", "lang": "zh", "citation": "中华医学会心血管病学分会, 等. 中国成人肥厚型心肌病诊断与治疗指南. 2023.", "text": "对于静息或激发左心室流出道压差≥50 mmHg，伴有严重药物难治性症状（NYHA Ⅲ/Ⅳ级）的患者，推荐外科室间隔切除术作为首选减容治疗。", "supersedes": [], "superseded_by": [], "verified": false, "confidence": "high", "ai_check": "ok"}
{"id": "hcm_8", "society": "CSC", "doc_title": "中国成人肥厚型心肌病诊断与治疗指南", "version": "2023", "effective_date": "2023", "status": "current", "topic": "hypertrophy_cardiomyopathy", "section": "运动建议", "class": "III", "LOE": "C", "lang": "zh", "citation": "中华医学会心血管病学分会, 等. 中国成人肥厚型心肌病诊断与治疗指南. 2023.", "text": "确诊肥厚型心肌病并伴有左心室肥厚的患者应避免参加竞技性运动和高强度体力活动，可参与低至中等强度的休闲运动。", "supersedes": [], "superseded_by": [], "verified": false, "confidence": "high", "ai_check": "ok"}
{"id": "hcm_9", "society": "CSC", "doc_title": "中国肥厚型心肌病诊断与治疗指南", "version": "2017", "effective_date": "2017", "status": "superseded", "topic": "hypertrophy_cardiomyopathy", "section": "猝死风险评估与ICD一级预防", "class": "I", "LOE": "B", "lang": "zh", "citation": "中华医学会心血管病学分会, 等. 中国肥厚型心肌病诊断与治疗指南. 2017.", "text": "对于5年心脏性猝死风险≥6%的肥厚型心肌病患者，推荐植入埋藏式心脏转复除颤器进行一级预防。", "supersedes": [], "superseded_by": ["hcm_10"], "verified": false, "confidence": "high", "ai_check": "ok"}
{"id": "hcm_10", "society": "CSC", "doc_title": "中国成人肥厚型心肌病诊断与治疗指南", "version": "2023", "effective_date": "2023", "status": "current", "topic": "hypertrophy_cardiomyopathy", "section": "猝死风险评估与ICD一级预防", "class": "IIa", "LOE": "B", "lang": "zh", "citation": "中华医学会心血管病学分会, 等. 中国成人肥厚型心肌病诊断与治疗指南. 2023.", "text": "对于5年心脏性猝死风险≥6%的肥厚型心肌病患者，应考虑植入埋藏式心脏转复除颤器进行一级预防。", "supersedes": ["hcm_9"], "superseded_by": [], "verified": false, "confidence": "high", "ai_check": "ok"}
{"id": "hcm_11", "society": "CSC", "doc_title": "中国肥厚型心肌病诊断与治疗指南", "version": "2017", "effective_date": "2017", "status": "superseded", "topic": "hypertrophy_cardiomyopathy", "section": "室间隔减容治疗", "class": "IIa", "LOE": "B", "lang": "zh", "citation": "中华医学会心血管病学分会, 等. 中国肥厚型心肌病诊断与治疗指南. 2017.", "text": "对于药物治疗无效、不适合或不能耐受外科手术的有症状梗阻性肥厚型心肌病患者，可考虑经皮酒精室间隔消融术。", "supersedes": [], "superseded_by": ["hcm_12"], "verified": false, "confidence": "high", "ai_check": "ok"}
{"id": "hcm_12", "society": "CSC", "doc_title": "中国成人肥厚型心肌病诊断与治疗指南", "version": "2023", "effective_date": "2023", "status": "current", "topic": "hypertrophy_cardiomyopathy", "section": "室间隔减容治疗", "class": "IIa", "LOE": "B", "lang": "zh", "citation": "中华医学会心血管病学分会, 等. 中国成人肥厚型心肌病诊断与治疗指南. 2023.", "text": "对于药物难治、有室间隔减容适应证但不适合或拒绝外科手术的患者，可选择酒精室间隔消融或室间隔射频消融术。", "supersedes": ["hcm_11"], "superseded_by": [], "verified": false, "confidence": "high", "ai_check": "ok"}
{"id": "hcm_13", "society": "CSC", "doc_title": "中国肥厚型心肌病诊断与治疗指南", "version": "2017", "effective_date": "2017", "status": "superseded", "topic": "hypertrophy_cardiomyopathy", "section": "运动建议", "class": "III", "LOE": "C", "lang": "zh", "citation": "中华医学会心血管病学分会, 等. 中国肥厚型心肌病诊断与治疗指南. 2017.", "text": "所有肥厚型心肌病患者及携带致病基因突变者均不推荐参加竞技性运动。", "supersedes": [], "superseded_by": ["hcm_14"], "verified": false, "confidence": "high", "ai_check": "ok"}
{"id": "hcm_14", "society": "CSC", "doc_title": "中国成人肥厚型心肌病诊断与治疗指南", "version": "2023", "effective_date": "2023", "status": "current", "topic": "hypertrophy_cardiomyopathy", "section": "运动建议", "class": "IIb", "LOE": "C", "lang": "zh", "citation": "中华医学会心血管病学分会, 等. 中国成人肥厚型心肌病诊断与治疗指南. 2023.", "text": "对于无左心室肥厚的基因型阳性个体，在无任何心电或影像学异常的情况下，可考虑参加竞技性运动。", "supersedes": ["hcm_13"], "superseded_by": [], "verified": false, "confidence": "high", "ai_check": "ok"}
